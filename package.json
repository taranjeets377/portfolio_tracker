{
  "name": "portfolio_tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss ./app/assets/builds/application.css",
    "watch": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets --watch",
    "watch:css": "sass ./app/assets/stylesheets/application.scss ./app/assets/builds/application.css --watch"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "sass": "^1.69.0"
  },
  "browserslist": [
    "defaults"
  ]
}
